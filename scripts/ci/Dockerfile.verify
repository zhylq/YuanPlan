FROM node:22-alpine3.24 AS node
FROM postgres:17-alpine3.24
COPY --from=node /usr/local/ /usr/local/
RUN apk upgrade --no-cache && apk add --no-cache git && rm /usr/local/bin/gosu
WORKDIR /workspace
# The normal build context exclusions keep credentials, data and Git history out.
COPY . .
ENTRYPOINT []
CMD ["node", "scripts/ci/verify.mjs"]
